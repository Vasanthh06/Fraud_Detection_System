# Shopzone environment configuration
ENV=development
DEMO_MODE=true

# Admin desk credentials (login: ADMIN_EMAIL / admin123)
ADMIN_EMAIL=adminhere@gmail.com
ADMIN_PASSWORD_HASH=$2b$12$... (bcrypt hash of your admin password)

# Change in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# Optional database override (defaults to data/shopzone.db)
# DB_PATH=

# ---- email + production (fill on Render) ----
RESEND_API_KEY=
RESEND_FROM=ShopZone <onboarding@resend.dev>
DATABASE_URL=
APP_URL=http://localhost:8000
