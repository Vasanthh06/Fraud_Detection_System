<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in — ShopZone</title>
  <script>try{if(localStorage.getItem("sz_theme")==="light")document.documentElement.dataset.theme="light";}catch(e){}</script>
  <link rel="stylesheet" href="/css/styles.css?v=2" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%2310b981'/><text x='50' y='68' font-size='52' text-anchor='middle' fill='%2304121a' font-family='Arial' font-weight='bold'>S</text></svg>" />
</head>
<body>
  <a class="auth-back" href="/">← Home</a>
  
    </form>
  </div>
  <script src="/js/api.js?v=2"></script>
  <script src="/js/store.js?v=2"></script>
  <script src="/js/ui.js?v=2"></script>
  <script>mountThemeFab();</script>
  <script>
    bindEye(document.getElementById('password'), document.getElementById('eyePw'));
    const form = document.getElementById('form');
    form.onsubmit = async (e) => {
      e.preventDefault();
      const err = document.getElementById('err');
      err.style.display = 'none';
      const go = document.getElementById('go');
      go.disabled = true; go.textContent = 'Signing in…';
      try {
        const data = await API.post('/auth/login', {
          email: document.getElementById('email').value.trim(),
          password: document.getElementById('password').value,
        });
        Auth.save(data.token, data.user);
        const next = new URLSearchParams(location.search).get('next');
        const safeNext = next && next.startsWith('/') && !next.startsWith('//') ? next : null;
        location.href = safeNext || (data.user.role === 'admin' ? '/admin' : '/shop');
      } catch (e2) {
        err.textContent = e2.message; err.style.display = '';
        go.disabled = false; go.textContent = 'Sign in';
      }
    };
  </script>
<script>
if (typeof togglePassword !== 'function') {
  function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    const eye = btn.querySelector('.eye-icon');
    const eyeOff = btn.querySelector('.eye-off-icon');
    if (input.type === "password") {
      input.type = "text";
      eye.style.display = "none"; eyeOff.style.display = "block";
    } else {
      input.type = "password";
      eye.style.display = "block"; eyeOff.style.display = "none";
    }
  }
}
</script>
</body>
</html>
